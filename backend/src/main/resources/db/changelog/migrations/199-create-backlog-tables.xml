<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
        F-178 SF-178-01 : tables du visualiseur de backlog (super-admin).
        Source de vérité = docs/PRODUCT_SPEC.md + docs/MARKETING_BACKLOG.md.
        Ces tables sont un cache de lecture alimenté par BacklogSyncService.
    -->

    <changeSet id="199-create-backlog-features" author="ailegalcase">
        <createTable tableName="backlog_features">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(32)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_backlog_features_code"/>
            </column>
            <column name="title" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="target_version" type="VARCHAR(32)"/>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="domain" type="VARCHAR(32)"/>
            <column name="priority" type="VARCHAR(16)"/>
            <column name="source_file" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="source_line" type="INT"/>
            <column name="parsed_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="is_orphaned" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="backlog_features" indexName="idx_backlog_features_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="backlog_features" indexName="idx_backlog_features_domain">
            <column name="domain"/>
        </createIndex>
    </changeSet>

    <changeSet id="199-create-backlog-subfeatures" author="ailegalcase">
        <createTable tableName="backlog_subfeatures">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_backlog_subfeatures_code"/>
            </column>
            <column name="parent_feature_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_backlog_subfeatures_parent"
                             references="backlog_features(id)"
                             deleteCascade="true"/>
            </column>
            <column name="title" type="VARCHAR(500)"/>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="source_file" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="source_line" type="INT"/>
            <column name="parsed_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="is_orphaned" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="backlog_subfeatures" indexName="idx_backlog_subfeatures_parent">
            <column name="parent_feature_id"/>
        </createIndex>
        <createIndex tableName="backlog_subfeatures" indexName="idx_backlog_subfeatures_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="199-create-backlog-marketing-tasks" author="ailegalcase">
        <createTable tableName="backlog_marketing_tasks">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(32)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_backlog_marketing_code"/>
            </column>
            <column name="title" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="category" type="VARCHAR(64)"/>
            <column name="source_file" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="source_line" type="INT"/>
            <column name="parsed_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="is_orphaned" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="backlog_marketing_tasks" indexName="idx_backlog_marketing_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="199-create-backlog-sync-runs" author="ailegalcase">
        <createTable tableName="backlog_sync_runs">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="started_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="finished_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="duration_ms" type="BIGINT"/>
            <column name="success" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="features_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="subfeatures_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="marketing_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="orphans_marked" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="triggered_by" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="error_message" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="backlog_sync_runs" indexName="idx_backlog_sync_runs_started">
            <column name="started_at" descending="true"/>
        </createIndex>
        <createIndex tableName="backlog_sync_runs" indexName="idx_backlog_sync_runs_success">
            <column name="success"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
