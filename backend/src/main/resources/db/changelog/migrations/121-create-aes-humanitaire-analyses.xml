<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="121-create-aes-humanitaire-analyses" author="legalcase">
        <comment>
            SF-IM-09-03 : table dédiée à l'outil décisionnel "AES voie humanitaire"
            (art. L.435-2 CESEDA + L.432-14 commission du titre de séjour). Calcule
            la probabilité d'acceptation d'une demande d'admission exceptionnelle
            au séjour pour motifs humanitaires (risques au retour, isolement total,
            victime de violences ou de traite, situation médicale précaire hors
            L.425-9, autre motif). Évalue l'adéquation des preuves au motif, la
            nécessité de saisir la commission du titre de séjour et produit un
            score global 0-100 et un verdict ELEVEE/MOYENNE/FAIBLE.
            Outil single-country FRANCE — pas d'équivalent BE standard.
            + 1 règle visibility F-IA-04 (ALWAYS_ON, DROIT_IMMIGRATION, FRANCE,
            priority 62) pour exposer l'outil sur tout dossier immigration FR.
        </comment>

        <createTable tableName="aes_humanitaire_analyses">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_aes_humanitaire_analyses_case_file"
                             referencedTableName="case_files"
                             referencedColumnNames="id"/>
            </column>
            <column name="date_entree_france" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="motif_humanitaire_dominant" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="preuves_medicales" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="preuves_violences_ou_traite" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="demande_asile_deposee_et_rejetee" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="commission_titre_sejour_saisie" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="menace_ordre_public" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="date_depot_demande" type="date">
                <constraints nullable="true"/>
            </column>
            <column name="country" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="result_data" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="aes_humanitaire_analyses"
                             columnNames="case_file_id"
                             constraintName="uq_aes_humanitaire_analyses_case_file"/>

        <createIndex tableName="aes_humanitaire_analyses"
                     indexName="idx_aes_humanitaire_analyses_case_file">
            <column name="case_file_id"/>
        </createIndex>

        <sql splitStatements="true">
            INSERT INTO decision_tool_visibility_rules (id, legal_domain, country, tool_id, layer, trigger_field, trigger_value, priority)
            VALUES ('f1a04001-0000-0000-0000-ee000000093a', 'DROIT_IMMIGRATION', 'FRANCE', 'F-IM-09-aes-humanitaire', 'ALWAYS_ON', NULL, NULL, 62);
        </sql>

        <rollback>
            <sql>
                DELETE FROM decision_tool_visibility_rules
                WHERE id = 'f1a04001-0000-0000-0000-ee000000093a';
            </sql>
            <dropTable tableName="aes_humanitaire_analyses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
