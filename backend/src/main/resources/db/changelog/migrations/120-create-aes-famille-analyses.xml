<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="120-create-aes-famille-analyses" author="legalcase">
        <comment>
            SF-IM-09-02 : table dédiée à l'outil décisionnel "AES voie familiale /
            liens personnels et familiaux" (art. L.435-1 CESEDA + circulaire Valls
            28/11/2012). Régularisation sur le fondement des liens personnels et
            familiaux en France, appréciée souverainement par le préfet selon un
            faisceau d'indices : durée de présence (5 ans signal fort, 10 ans
            quasi-automatique), conjoint français ou régulier, enfants scolarisés,
            insertion (contrat, formation, logement), absence de trouble à l'ordre
            public. Scoring pondéré 0-100 avec verdicts ELEVEE/MOYENNE/FAIBLE.
            Outil single-country FRANCE — pas d'équivalent BE standard.
            + 1 règle visibility F-IA-04 (ALWAYS_ON, DROIT_IMMIGRATION, FRANCE,
            priority 61) pour exposer l'outil sur tout dossier immigration FR.
        </comment>

        <createTable tableName="aes_famille_analyses">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_aes_famille_analyses_case_file"
                             referencedTableName="case_files"
                             referencedColumnNames="id"/>
            </column>
            <column name="date_entree_france" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="duree_presence_mois" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="conjoint_francais_ou_regulier" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="enfants_scolarises_france" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="duree_scolarite_plus_ancien_enfant_annees" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="preuves_insertion" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="menace_ordre_public" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="date_depot_demande" type="date">
                <constraints nullable="true"/>
            </column>
            <column name="country" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="result_data" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="aes_famille_analyses"
                             columnNames="case_file_id"
                             constraintName="uq_aes_famille_analyses_case_file"/>

        <createIndex tableName="aes_famille_analyses"
                     indexName="idx_aes_famille_analyses_case_file">
            <column name="case_file_id"/>
        </createIndex>

        <sql splitStatements="true">
            INSERT INTO decision_tool_visibility_rules (id, legal_domain, country, tool_id, layer, trigger_field, trigger_value, priority)
            VALUES ('f1a04001-0000-0000-0000-ee000000092a', 'DROIT_IMMIGRATION', 'FRANCE', 'F-IM-09-aes-famille', 'ALWAYS_ON', NULL, NULL, 61);
        </sql>

        <rollback>
            <sql>
                DELETE FROM decision_tool_visibility_rules
                WHERE id = 'f1a04001-0000-0000-0000-ee000000092a';
            </sql>
            <dropTable tableName="aes_famille_analyses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
