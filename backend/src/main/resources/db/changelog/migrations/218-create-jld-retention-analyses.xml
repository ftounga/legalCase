<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="218-create-jld-retention-analyses" author="legalcase">
        <comment>
            SF-208-01 : table dédiée à l'outil décisionnel "JLD rétention administrative"
            (Juge des libertés et de la détention) — CESEDA L.741+ et L.743+ + loi 26/01/2024.
            Calcule les délais critiques de la procédure : 48 h saisine JLD, 5 j audience,
            24 h appel.
            Outil single-country FRANCE — la chambre du conseil belge (Loi 15/12/1980 art. 71+)
            sera traitée par F-209 si pertinent.
            + 1 règle visibility F-IA-04 (CONTEXTUAL, DROIT_IMMIGRATION, FRANCE,
            trigger=mesure_eloignement_detectee=true) — réutilise un flag IA existant
            (livré par F-201 SF-201-01).

            Audit "Impact F-166 cross-C×D" : impacte uniquement Immigration FR.
            Audit "exhaustivité droit national FR" : équivalent BE (chambre du conseil)
            volontairement différé à F-209 P1 Immigration BE.
        </comment>

        <createTable tableName="jld_retention_analyses">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_jld_retention_analyses_case_file"
                             referencedTableName="case_files"
                             referencedColumnNames="id"/>
            </column>
            <column name="date_notification_placement" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="motif_placement" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="recours_forme" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="date_recours" type="date">
                <constraints nullable="true"/>
            </column>
            <column name="country" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="result_data" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="jld_retention_analyses"
                             columnNames="case_file_id"
                             constraintName="uq_jld_retention_analyses_case_file"/>

        <createIndex tableName="jld_retention_analyses"
                     indexName="idx_jld_retention_analyses_case_file">
            <column name="case_file_id"/>
        </createIndex>

        <sql splitStatements="true">
INSERT INTO decision_tool_visibility_rules (id, legal_domain, country, tool_id, layer, trigger_field, trigger_value, priority)
VALUES ('f1a04001-0000-0000-0000-eeee20800210', 'DROIT_IMMIGRATION', 'FRANCE', 'F-IM-21-jld-retention-fr', 'CONTEXTUAL', 'mesure_eloignement_detectee', 'true', 70);
        </sql>

        <rollback>
            <sql>
                DELETE FROM decision_tool_visibility_rules
                WHERE id = 'f1a04001-0000-0000-0000-eeee20800210';
            </sql>
            <dropTable tableName="jld_retention_analyses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
