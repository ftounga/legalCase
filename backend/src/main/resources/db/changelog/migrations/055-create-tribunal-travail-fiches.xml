<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="055-create-tribunal-travail-fiches" author="legalcase">
        <comment>
            Crée la table tribunal_travail_fiches — requête contradictoire devant
            le tribunal du travail belge (art. 702/704 Code judiciaire).
            Équivalent belge de la fiche prud'homale (prudhome_fiches).
        </comment>

        <createTable tableName="tribunal_travail_fiches">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="UUID">
                <constraints nullable="false" unique="true"
                             foreignKeyName="fk_tribunal_travail_fiches_case_file"
                             references="case_files(id)"
                             deleteCascade="true"/>
            </column>
            <column name="requerant" type="TEXT" defaultValue="{}">
                <constraints nullable="false"/>
            </column>
            <column name="defendeur" type="TEXT" defaultValue="{}">
                <constraints nullable="false"/>
            </column>
            <column name="procedure_info" type="TEXT" defaultValue="{}">
                <constraints nullable="false"/>
            </column>
            <column name="contrat_info" type="TEXT" defaultValue="{}">
                <constraints nullable="false"/>
            </column>
            <column name="demandes" type="TEXT" defaultValue="[]">
                <constraints nullable="false"/>
            </column>
            <column name="expose_des_moyens" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>

</databaseChangeLog>
