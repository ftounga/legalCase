<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="556-create-regime-mayotte-analyses" author="legalcase">
        <comment>
            SF-220-02 — table `regime_mayotte_analyses` pour l'outil décisionnel
            "Portée territoriale du titre à Mayotte" (F-IM-48-regime-mayotte-fr, FRANCE).

            Outil single-country FR : analyse la portée territoriale d'un titre
            délivré à Mayotte (Ord. 2014-464, CESEDA L.832-1 et s.). Un titre
            mahorais ne vaut PAS autorisation de circuler / séjourner en métropole
            sans démarche spécifique. Distinct de F-IM-05 (arbre titre généraliste) :
            objet = dérogation territoriale, pas le choix du titre. L'AME Mayotte
            (droit social connexe) est écartée. Persiste l'analyse 1:1 par dossier.

            Verdict portee_territoriale : MAYOTTE_UNIQUEMENT / DROIT_COMMUN.
            Sous-statut deplacement : BLOCAGE_DEPLACEMENT / DEPLACEMENT_LIBRE.

            Source juridique (à vérifier par avocat) : Ordonnance n° 2014-464 du
            7 mai 2014 ; CESEDA L.832-1 et suivants.

            UUID namespace F-220 : f2200003-0000-0000-0000-220000000001.
        </comment>

        <createTable tableName="regime_mayotte_analyses">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="UUID">
                <constraints nullable="false" unique="true"
                             foreignKeyName="fk_regime_mayotte_case_file"
                             references="case_files(id)"/>
            </column>
            <column name="titre_delivre_a_mayotte" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="type_titre" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="projet_deplacement_metropole" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="date_delivrance" type="DATE">
                <constraints nullable="true"/>
            </column>
            <column name="country" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="result_data" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="regime_mayotte_analyses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
