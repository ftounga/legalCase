<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="129-create-divorce-accepte-analyses" author="legalcase">
        <comment>
            SF-FA-10-01 : table dédiée à l'outil décisionnel "Divorce accepté /
            acceptation du principe de la rupture" (art. 233-234 Cciv + art. 1123
            CPC). Les époux acceptent le principe de la rupture sans considération
            des faits. L'acceptation est formalisée par procès-verbal signé et
            devient irrévocable. Pas de DI art. 266 (réservé divorce pour faute),
            mais prestation compensatoire art. 270 possible.
            Scoring simple : acceptation valide = 100 (ELEVEE) sinon 0 (FAIBLE).
            Durée procédurale prévisionnelle ~8-12 mois (moyenne 10).
            Outil single-country FRANCE + DROIT_FAMILLE.
            + 1 règle visibility F-IA-04 (ALWAYS_ON, DROIT_FAMILLE, FRANCE,
            priority 72) pour exposer l'outil sur tout dossier famille FR.
        </comment>

        <createTable tableName="divorce_accepte_analyses">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_divorce_accepte_analyses_case_file"
                             referencedTableName="case_files"
                             referencedColumnNames="id"/>
            </column>
            <column name="acceptation_principe_signee" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="date_acceptation_pv" type="date">
                <constraints nullable="true"/>
            </column>
            <column name="duree_mariage_annees" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="revenus_annuels_epoux1_eur" type="numeric(12,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="revenus_annuels_epoux2_eur" type="numeric(12,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="patrimoine_commun" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="date_assignation" type="date">
                <constraints nullable="true"/>
            </column>
            <column name="country" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="result_data" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="divorce_accepte_analyses"
                             columnNames="case_file_id"
                             constraintName="uq_divorce_accepte_analyses_case_file"/>

        <createIndex tableName="divorce_accepte_analyses"
                     indexName="idx_divorce_accepte_analyses_case_file">
            <column name="case_file_id"/>
        </createIndex>

        <sql splitStatements="true">
            INSERT INTO decision_tool_visibility_rules (id, legal_domain, country, tool_id, layer, trigger_field, trigger_value, priority)
            VALUES ('f1a04001-0000-0000-0000-ee00000fa101', 'DROIT_FAMILLE', 'FRANCE', 'F-FA-10-divorce-accepte', 'ALWAYS_ON', NULL, NULL, 72);
        </sql>

        <rollback>
            <sql>
                DELETE FROM decision_tool_visibility_rules
                WHERE id = 'f1a04001-0000-0000-0000-ee00000fa101';
            </sql>
            <dropTable tableName="divorce_accepte_analyses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
