<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="180-create-pma-gpa-bioethique-analyses" author="legalcase">
        <comment>
            SF-FA-27-01 : table dédiée à l'outil décisionnel "PMA / GPA / bioéthique" (FR).
            Évalue la recevabilité d'une demande au regard de la loi bioéthique 2/8/2021 +
            jurisprudence Cass. ass. plén. 18/12/2022 (4 arrêts GPA, Ménesson et al.).
            3 dispositifs distincts :
              - PMA_RECONNAISSANCE_ANTICIPEE (art. 342-9 et s. Cciv) : reconnaissance conjointe
                notariée AVANT la PMA pour couples de femmes ou femmes seules.
              - GPA_TRANSCRIPTION_ETAT_CIVIL (Cass. 18/12/2022) : transcription parent biologique
                + adoption simple (art. 360+) pour parent d'intention.
              - DON_GAMETES_ACCES_ORIGINES (art. 16-8-1 Cciv depuis 1/9/2022) : accès à 18 ans
                à l'identité du donneur via la CAPADD.
            Verdict ELEVEE / MOYENNE / FAIBLE selon : antériorité de la reconnaissance (PMA),
            pays légal + lien biologique + adoption parallèle (GPA), âge ≥ 18 + demande +
            don postérieur 1/9/2022 (accès origines).

            Outil single-country FRANCE — l'équivalent BE (loi 6/7/2007 PMA BE) sera traité
            dans une feature jumelle au backlog (F-FA-27-BE).

            + 1 règle visibility F-IA-04 (ALWAYS_ON, DROIT_FAMILLE, FRANCE, priority 89).
        </comment>

        <createTable tableName="pma_gpa_bioethique_analyses">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_pma_gpa_bioethique_analyses_case_file"
                             referencedTableName="case_files"
                             referencedColumnNames="id"/>
            </column>
            <column name="dispositif" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="consentements_conjoints_notaire" type="boolean">
                <constraints nullable="true"/>
            </column>
            <column name="date_reconnaissance_anterieure_pma" type="date">
                <constraints nullable="true"/>
            </column>
            <column name="date_pma" type="date">
                <constraints nullable="true"/>
            </column>
            <column name="conditions_acces_pma" type="boolean">
                <constraints nullable="true"/>
            </column>
            <column name="pays_gpa_legal" type="boolean">
                <constraints nullable="true"/>
            </column>
            <column name="parent_biologique_avere" type="boolean">
                <constraints nullable="true"/>
            </column>
            <column name="decision_etrangere_produite" type="boolean">
                <constraints nullable="true"/>
            </column>
            <column name="adoption_demande" type="boolean">
                <constraints nullable="true"/>
            </column>
            <column name="date_don" type="date">
                <constraints nullable="true"/>
            </column>
            <column name="demande_acces" type="boolean">
                <constraints nullable="true"/>
            </column>
            <column name="age_demandeur" type="int">
                <constraints nullable="true"/>
            </column>
            <column name="country" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="result_data" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="pma_gpa_bioethique_analyses"
                             columnNames="case_file_id"
                             constraintName="uq_pma_gpa_bioethique_analyses_case_file"/>

        <createIndex tableName="pma_gpa_bioethique_analyses"
                     indexName="idx_pma_gpa_bioethique_analyses_case_file">
            <column name="case_file_id"/>
        </createIndex>

        <sql splitStatements="true">
            INSERT INTO decision_tool_visibility_rules (id, legal_domain, country, tool_id, layer, trigger_field, trigger_value, priority)
            VALUES ('f1a04001-0000-0000-0000-ee0000000180', 'DROIT_FAMILLE', 'FRANCE', 'F-FA-27-pma-gpa', 'ALWAYS_ON', NULL, NULL, 89);
        </sql>

        <rollback>
            <sql>
                DELETE FROM decision_tool_visibility_rules
                WHERE id = 'f1a04001-0000-0000-0000-ee0000000180';
            </sql>
            <dropTable tableName="pma_gpa_bioethique_analyses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
