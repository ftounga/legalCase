<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="112-create-discrimination-analyses" author="legalcase">
        <comment>
            SF-DT-12-01 : table dédiée à l'outil décisionnel "Discrimination — dommages-intérêts"
            (art. L.1134-5 FR + Loi 10 mai 2007 BE). Complémentaire à F-DT-11 (indemnité nullité).
            Fourchette indicative basée sur jurisprudence chambre sociale.
            + 2 règles visibility F-IA-04 (ALWAYS_ON, DROIT_DU_TRAVAIL, FRANCE + BELGIQUE).
        </comment>

        <createTable tableName="discrimination_analyses">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_discrimination_analyses_case_file"
                             referencedTableName="case_files"
                             referencedColumnNames="id"/>
            </column>
            <column name="salaire_mensuel_reference" type="numeric(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="motif_discrimination" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="contexte_acte" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="country" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="result_data" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="discrimination_analyses"
                             columnNames="case_file_id"
                             constraintName="uq_discrimination_analyses_case_file"/>

        <createIndex tableName="discrimination_analyses"
                     indexName="idx_discrimination_analyses_case_file">
            <column name="case_file_id"/>
        </createIndex>

        <sql splitStatements="true">
            INSERT INTO decision_tool_visibility_rules (id, legal_domain, country, tool_id, layer, trigger_field, trigger_value, priority)
            VALUES ('f1a04001-0000-0000-0000-ee0000000121', 'DROIT_DU_TRAVAIL', 'FRANCE', 'F-DT-12-discrimination-dommages-interets', 'ALWAYS_ON', NULL, NULL, 53);
            INSERT INTO decision_tool_visibility_rules (id, legal_domain, country, tool_id, layer, trigger_field, trigger_value, priority)
            VALUES ('f1a04001-0000-0000-0000-ee0000000122', 'DROIT_DU_TRAVAIL', 'BELGIQUE', 'F-DT-12-discrimination-dommages-interets', 'ALWAYS_ON', NULL, NULL, 53);
        </sql>

        <rollback>
            <sql>
                DELETE FROM decision_tool_visibility_rules
                WHERE id IN ('f1a04001-0000-0000-0000-ee0000000121', 'f1a04001-0000-0000-0000-ee0000000122');
            </sql>
            <dropTable tableName="discrimination_analyses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
