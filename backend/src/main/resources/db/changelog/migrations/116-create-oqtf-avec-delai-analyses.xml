<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="116-create-oqtf-avec-delai-analyses" author="legalcase">
        <comment>
            SF-IM-08-01 : table dédiée à l'outil décisionnel "OQTF avec délai de départ volontaire"
            (art. L.614-5 CESEDA). Calcule les délais de recours devant le TA, statut du délai,
            dates d'audience et de décision prévisionnelles, et identifie les référés L.521-1
            (suspension) et L.521-2 (liberté) disponibles.
            Outil single-country FRANCE — l'annexe 13 belge est une procédure juridiquement
            distincte couverte par SF-IM-08-05.
            + 1 règle visibility F-IA-04 (CONTEXTUAL, DROIT_IMMIGRATION, FRANCE,
            trigger type_procedure_detectee=OQTF_AVEC_DELAI).
        </comment>

        <createTable tableName="oqtf_avec_delai_analyses">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_oqtf_avec_delai_analyses_case_file"
                             referencedTableName="case_files"
                             referencedColumnNames="id"/>
            </column>
            <column name="date_notification_oqtf" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="motif_oqtf" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="recours_forme" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="date_recours" type="date">
                <constraints nullable="true"/>
            </column>
            <column name="country" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="result_data" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="oqtf_avec_delai_analyses"
                             columnNames="case_file_id"
                             constraintName="uq_oqtf_avec_delai_analyses_case_file"/>

        <createIndex tableName="oqtf_avec_delai_analyses"
                     indexName="idx_oqtf_avec_delai_analyses_case_file">
            <column name="case_file_id"/>
        </createIndex>

        <sql splitStatements="true">
            INSERT INTO decision_tool_visibility_rules (id, legal_domain, country, tool_id, layer, trigger_field, trigger_value, priority)
            VALUES ('f1a04001-0000-0000-0000-ee000000081a', 'DROIT_IMMIGRATION', 'FRANCE', 'F-IM-08-oqtf-avec-delai-fr', 'CONTEXTUAL', 'type_procedure_detectee', 'OQTF_AVEC_DELAI', 57);
        </sql>

        <rollback>
            <sql>
                DELETE FROM decision_tool_visibility_rules
                WHERE id = 'f1a04001-0000-0000-0000-ee000000081a';
            </sql>
            <dropTable tableName="oqtf_avec_delai_analyses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
