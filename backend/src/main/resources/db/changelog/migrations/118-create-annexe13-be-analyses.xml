<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="118-create-annexe13-be-analyses" author="legalcase">
        <comment>
            SF-IM-08-05 : table dédiée à l'outil décisionnel "Annexe 13 BE — ordre de quitter le
            territoire belge" (Loi 15/12/1980 art. 7 + 39/2 §2 + 39/82 §4 + AR 08/10/1981).
            Calcule les délais de recours devant le Conseil du contentieux des étrangers (CCE) :
            30 jours calendaires pour le recours en annulation et 5 jours ouvrables pour le recours
            en extrême urgence (via BelgianBusinessDaysCalculator).
            Outil single-country BELGIQUE — l'OQTF française est une procédure juridiquement
            distincte couverte par SF-IM-08-01/03.
            + 1 règle visibility F-IA-04 (ALWAYS_ON, DROIT_IMMIGRATION, BELGIQUE) — outil toujours
            affiché pour dossiers immigration BE (évite extension enum type_procedure_detectee).
        </comment>

        <createTable tableName="annexe13_be_analyses">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_annexe13_be_analyses_case_file"
                             referencedTableName="case_files"
                             referencedColumnNames="id"/>
            </column>
            <column name="date_notification_annexe13" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="delai_depart_impose_jours" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="motif_oqt" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="transfert_imminent" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="recours_forme" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="date_recours" type="date">
                <constraints nullable="true"/>
            </column>
            <column name="type_recours" type="varchar(30)">
                <constraints nullable="true"/>
            </column>
            <column name="country" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="result_data" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="annexe13_be_analyses"
                             columnNames="case_file_id"
                             constraintName="uq_annexe13_be_analyses_case_file"/>

        <createIndex tableName="annexe13_be_analyses"
                     indexName="idx_annexe13_be_analyses_case_file">
            <column name="case_file_id"/>
        </createIndex>

        <sql splitStatements="true">
            INSERT INTO decision_tool_visibility_rules (id, legal_domain, country, tool_id, layer, trigger_field, trigger_value, priority)
            VALUES ('f1a04001-0000-0000-0000-ee000000085a', 'DROIT_IMMIGRATION', 'BELGIQUE', 'F-IM-08-annexe13-be', 'ALWAYS_ON', NULL, NULL, 59);
        </sql>

        <rollback>
            <sql>
                DELETE FROM decision_tool_visibility_rules
                WHERE id = 'f1a04001-0000-0000-0000-ee000000085a';
            </sql>
            <dropTable tableName="annexe13_be_analyses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
