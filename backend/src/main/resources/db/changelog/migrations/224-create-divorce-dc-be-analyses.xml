<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="224-create-divorce-dc-be-analyses" author="legalcase">
        <comment>
            SF-211-01 : table dédiée à l'outil décisionnel "Divorce par consentement
            mutuel (DC) belge" — CJ art. 1287-1304 + Loi 27/04/2007 + CC art. 229 §1.

            Vérifie : convention préalable complète (logement / biens / garde enfants /
            contributions) ; délai de réflexion ≥ 3 mois ; consentement des 2 époux.
            Verdict RECEVABLE / IRRECEVABLE / NON_CONCERNE.

            Outil single-country BELGIQUE. Équivalent FR : DC déjudiciarisé depuis 2017
            (art. 229-1+ CC FR) — procédure radicalement différente.

            Audit "Impact F-166 cross-C×D" : impacte uniquement BE×Famille.
            Audit "exhaustivité droit national BE" : couvre la DC belge, équivalent FR
            volontairement non couvert ici (concept déjudiciarisé hors champ).

            Le seed `decision_tool_visibility_rules` est volontairement différé à une
            SF F-211 frontend ultérieure : sans entrée TOOL_REGISTRY frontend, le
            garde-fou DecisionToolVisibilityIntegrityIT échouerait (extraction
            dynamique de la liste TS, voir test SF-164-01).
        </comment>

        <createTable tableName="divorce_dc_be_analyses">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_divorce_dc_be_analyses_case_file"
                             referencedTableName="case_files"
                             referencedColumnNames="id"/>
            </column>
            <column name="date_signature_convention" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="date_audience_homologation" type="date">
                <constraints nullable="true"/>
            </column>
            <column name="convention_logement" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="convention_biens" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="convention_garde_enfants" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="convention_contributions" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="enfants_mineurs_communs" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="epoux_consentent" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="country" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="result_data" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="divorce_dc_be_analyses"
                             columnNames="case_file_id"
                             constraintName="uq_divorce_dc_be_analyses_case_file"/>

        <createIndex tableName="divorce_dc_be_analyses"
                     indexName="idx_divorce_dc_be_analyses_case_file">
            <column name="case_file_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="divorce_dc_be_analyses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
