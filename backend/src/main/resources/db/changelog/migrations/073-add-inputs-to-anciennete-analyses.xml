<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="073-add-inputs-to-anciennete-analyses" author="legalcase">
        <addColumn tableName="anciennete_analyses">
            <column name="salaire_base" type="NUMERIC(12,2)"/>
        </addColumn>
        <addColumn tableName="anciennete_analyses">
            <column name="conges_contrat" type="INTEGER"/>
        </addColumn>
        <addColumn tableName="anciennete_analyses">
            <column name="prime_contrat" type="NUMERIC(5,2)"/>
        </addColumn>

        <rollback>
            <dropColumn tableName="anciennete_analyses" columnName="salaire_base"/>
            <dropColumn tableName="anciennete_analyses" columnName="conges_contrat"/>
            <dropColumn tableName="anciennete_analyses" columnName="prime_contrat"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
