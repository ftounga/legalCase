<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="454-create-oqtf-categories-analyses" author="legalcase">
        <comment>
            SF-214-09 : table dédiée à l'outil décisionnel "OQTF catégories L. 611-1 CESEDA"
            (F-IM-29-oqtf-categories-l6111-fr, FRANCE uniquement). Détermine la catégorie
            d'OQTF parmi les 7 de L. 611-1 (1° à 7°) et les moyens de défense spécifiques.
            Complémentaire de F-IM-08 (OQTF avec/sans délai). 1:1 case_file.
        </comment>

        <createTable tableName="oqtf_categories_analyses">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_oqtf_categories_analyses_case_file"
                             referencedTableName="case_files"
                             referencedColumnNames="id"/>
            </column>
            <column name="categorie_l611" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="date_notification_oqtf" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="motif_oqtf" type="varchar(300)">
                <constraints nullable="true"/>
            </column>
            <column name="country" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="result_data" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="oqtf_categories_analyses"
                             columnNames="case_file_id"
                             constraintName="uq_oqtf_categories_analyses_case_file"/>

        <createIndex tableName="oqtf_categories_analyses"
                     indexName="idx_oqtf_categories_analyses_case_file">
            <column name="case_file_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="oqtf_categories_analyses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
