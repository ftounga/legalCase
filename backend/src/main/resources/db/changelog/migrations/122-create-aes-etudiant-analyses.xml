<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="122-create-aes-etudiant-analyses" author="legalcase">
        <comment>
            SF-IM-09-04 : table dédiée à l'outil décisionnel "AES voie étudiante"
            (circulaire Valls 28/11/2012 point III actualisée Darmanin 2024 +
            art. L.412-1 CESEDA). Régularisation d'un étranger présent en France
            et poursuivant des études sans titre adapté — appréciation en faisceau
            d'indices : présence ≥ 3 ans, scolarité ≥ 2 années consécutives,
            résultats décents, inscription dans un établissement reconnu, moyens
            de subsistance stables, pas de menace ordre public, parcours cohérent.
            Outil single-country FRANCE — pas d'équivalent BE standard.
            + 1 règle visibility F-IA-04 (ALWAYS_ON, DROIT_IMMIGRATION, FRANCE,
            priority 63) pour exposer l'outil sur tout dossier immigration FR.
        </comment>

        <createTable tableName="aes_etudiant_analyses">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_aes_etudiant_analyses_case_file"
                             referencedTableName="case_files"
                             referencedColumnNames="id"/>
            </column>
            <column name="date_entree_france" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="duree_presence_mois" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="annees_scolarite_en_france_consecutives" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="niveau_etudes_actuel" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="resultats_academiques" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="inscription_etablissement_reconnu" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="moyens_subsistance" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="menace_ordre_public" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="parcours_coherent" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="date_depot_demande" type="date">
                <constraints nullable="true"/>
            </column>
            <column name="country" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="result_data" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="aes_etudiant_analyses"
                             columnNames="case_file_id"
                             constraintName="uq_aes_etudiant_analyses_case_file"/>

        <createIndex tableName="aes_etudiant_analyses"
                     indexName="idx_aes_etudiant_analyses_case_file">
            <column name="case_file_id"/>
        </createIndex>

        <sql splitStatements="true">
            INSERT INTO decision_tool_visibility_rules (id, legal_domain, country, tool_id, layer, trigger_field, trigger_value, priority)
            VALUES ('f1a04001-0000-0000-0000-ee000000094a', 'DROIT_IMMIGRATION', 'FRANCE', 'F-IM-09-aes-etudiant', 'ALWAYS_ON', NULL, NULL, 63);
        </sql>

        <rollback>
            <sql>
                DELETE FROM decision_tool_visibility_rules
                WHERE id = 'f1a04001-0000-0000-0000-ee000000094a';
            </sql>
            <dropTable tableName="aes_etudiant_analyses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
