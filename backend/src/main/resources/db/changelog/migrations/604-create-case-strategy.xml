<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="604-create-case-strategy" author="legalcase">
        <comment>
            F-286 / SF-286-01 — stratégie de dossier unifiée. Couche LLM de synthèse
            EN LECTURE : une ligne courante par dossier portant la recommandation
            stratégique consolidée (générée à partir des verdicts des outils CALCULÉS
            + de la synthèse). Table ADDITIVE — aucune écriture sur les tables *_analysis
            des outils ni sur decision_tool_visibility_rules (invariant 1 outil = 1
            situation préservé). Isolation workspace via case_file_id. Unicité
            case_file_id = upsert (1 stratégie courante par dossier).
        </comment>

        <createTable tableName="case_strategy">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="uuid">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_case_strategy_case_file"/>
            </column>
            <column name="content" type="text"/>
            <column name="tools_considered" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="model_used" type="varchar(100)"/>
            <column name="prompt_tokens" type="int"/>
            <column name="completion_tokens" type="int"/>
            <column name="generated_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="case_strategy" baseColumnNames="case_file_id"
                referencedTableName="case_files" referencedColumnNames="id"
                constraintName="fk_case_strategy_case_file" onDelete="CASCADE"/>

        <rollback>
            <dropTable tableName="case_strategy"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
