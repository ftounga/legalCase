<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="117-create-oqtf-sans-delai-analyses" author="legalcase">
        <comment>
            SF-IM-08-03 : table dédiée à l'outil décisionnel "OQTF sans délai de départ volontaire"
            (art. L.731-1 CESEDA). Procédure d'extrême urgence — recours 48h devant juge unique TA
            (L.614-8), audience 96h (R.776-26), décision 6 semaines (R.776-27). Calcule
            heuresRestantes (LocalDateTime + ChronoUnit.HOURS), statut du délai, dates d'audience
            et de décision prévisionnelles, et gère le placement en CRA (ajout
            CONTROLE_JLD_LIBERTE dans refereDisponibles + message L.742-1).
            Outil single-country FRANCE — la procédure BE (annexe 13) est juridiquement distincte
            et couverte par SF-IM-08-05.
            + 1 règle visibility F-IA-04 (CONTEXTUAL, DROIT_IMMIGRATION, FRANCE,
            trigger type_procedure_detectee=OQTF_SANS_DELAI, priority 58).
        </comment>

        <createTable tableName="oqtf_sans_delai_analyses">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_oqtf_sans_delai_analyses_case_file"
                             referencedTableName="case_files"
                             referencedColumnNames="id"/>
            </column>
            <column name="date_heure_notification_oqtf" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="motif_sans_delai" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="placement_cra" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="recours_forme" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="date_heure_recours" type="timestamp">
                <constraints nullable="true"/>
            </column>
            <column name="country" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="result_data" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="oqtf_sans_delai_analyses"
                             columnNames="case_file_id"
                             constraintName="uq_oqtf_sans_delai_analyses_case_file"/>

        <createIndex tableName="oqtf_sans_delai_analyses"
                     indexName="idx_oqtf_sans_delai_analyses_case_file">
            <column name="case_file_id"/>
        </createIndex>

        <sql splitStatements="true">
            INSERT INTO decision_tool_visibility_rules (id, legal_domain, country, tool_id, layer, trigger_field, trigger_value, priority)
            VALUES ('f1a04001-0000-0000-0000-ee000000083a', 'DROIT_IMMIGRATION', 'FRANCE', 'F-IM-08-oqtf-sans-delai-fr', 'CONTEXTUAL', 'type_procedure_detectee', 'OQTF_SANS_DELAI', 58);
        </sql>

        <rollback>
            <sql>
                DELETE FROM decision_tool_visibility_rules
                WHERE id = 'f1a04001-0000-0000-0000-ee000000083a';
            </sql>
            <dropTable tableName="oqtf_sans_delai_analyses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
