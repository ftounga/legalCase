<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="141-create-licenciement-economique-analyses" author="legalcase">
        <comment>
            SF-DT-13-01 : table dédiée à l'outil décisionnel "Licenciement économique" (FR).
            Évalue le risque de requalification d'un licenciement pour motif économique selon
            3 axes (art. L.1233-3 + L.1233-4 + L.1233-5 + L.1233-45 Code du travail) :
            - causalité du motif (motif reconnu + preuves matérielles)
            - critères d'ordre (4 obligatoires : âge, ancienneté, charges famille, qualités prof)
            - obligation de reclassement + priorité de réembauche 1 an

            Outil single-country FRANCE — l'équivalent BE (licenciement collectif Loi Renault)
            est traité dans F-DT-14 PSE.

            + 1 règle visibility F-IA-04 (ALWAYS_ON, DROIT_DU_TRAVAIL, FRANCE, priority 55).
        </comment>

        <createTable tableName="licenciement_economique_analyses">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_licenciement_economique_analyses_case_file"
                             referencedTableName="case_files"
                             referencedColumnNames="id"/>
            </column>
            <column name="motif_economique_invoque" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="preuves_motif_json" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="criteres_ordre_json" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="salarie_age" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="salarie_anciennete_mois" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="salarie_charges_famille" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="salarie_qualites_prof" type="varchar(20)">
                <constraints nullable="true"/>
            </column>
            <column name="tentatives_reclassement_json" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="priorite_reembauche_propose" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="conge_reclassement_propose" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="date_notification" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="country" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="result_data" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="licenciement_economique_analyses"
                             columnNames="case_file_id"
                             constraintName="uq_licenciement_economique_analyses_case_file"/>

        <createIndex tableName="licenciement_economique_analyses"
                     indexName="idx_licenciement_economique_analyses_case_file">
            <column name="case_file_id"/>
        </createIndex>

        <sql splitStatements="true">
            INSERT INTO decision_tool_visibility_rules (id, legal_domain, country, tool_id, layer, trigger_field, trigger_value, priority)
            VALUES ('f1a04001-0000-0000-0000-ee0000000131', 'DROIT_DU_TRAVAIL', 'FRANCE', 'F-DT-13-licenciement-economique', 'ALWAYS_ON', NULL, NULL, 55);
        </sql>

        <rollback>
            <sql>
                DELETE FROM decision_tool_visibility_rules
                WHERE id = 'f1a04001-0000-0000-0000-ee0000000131';
            </sql>
            <dropTable tableName="licenciement_economique_analyses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
