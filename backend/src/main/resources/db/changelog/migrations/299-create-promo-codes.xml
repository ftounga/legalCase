<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="299-create-promo-codes" author="legalcase">
        <comment>
            F-255 SF-255-01 — création de la table `promo_codes`.

            Source de vérité des codes promo / coupons partenaires gérés par
            le super-admin (création/listing/désactivation). Deux types
            supportés au niveau du schéma :
              * TRIAL_EXTENSION — extension d'essai locale (sans Stripe),
                pleinement opérationnel en SF-01 (cette migration).
              * STRIPE_DISCOUNT — réduction abonnement via Stripe Coupons,
                stocké mais redemption non supportée en SF-01 (409
                PROMO_CODE_TYPE_NOT_SUPPORTED_YET — implémenté par SF-255-04).

            Le champ `code` est volontairement contraint global unique : un
            même code ne peut pas cohabiter sur deux types différents. La
            normalisation trim + uppercase est appliquée côté Java avant
            INSERT (entité PromoCode), pas via constraint SQL.

            `uses_count` est mis à jour atomiquement par
            `PromoCodeRepository.incrementUsesCount` via @Modifying Query
            avec garde-fou `WHERE uses_count &lt; max_uses` — un UPDATE
            retournant 0 rows = code épuisé, traduit en 409
            PROMO_CODE_EXHAUSTED. Pas de SELECT FOR UPDATE.

            `stripe_coupon_id` reste NULL en V1, renseigné par SF-255-04.

            Namespace UUID F-255 SF-01 (réservé pour traçabilité audit
            cross-environnement) : f1a04002-0000-0000-0000-eeee25500101.
        </comment>

        <createTable tableName="promo_codes">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="varchar(64)">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_promo_codes_code"/>
            </column>
            <column name="type" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="value_days" type="int"/>
            <column name="stripe_coupon_id" type="varchar(255)"/>
            <column name="partner_label" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="max_uses" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="uses_count" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="promo_codes"
                baseColumnNames="created_by_user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_promo_codes_created_by_user_id"/>

        <createIndex tableName="promo_codes"
                     indexName="idx_promo_codes_active_expires_at">
            <column name="active"/>
            <column name="expires_at"/>
        </createIndex>

        <rollback>
            <dropTable tableName="promo_codes"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
