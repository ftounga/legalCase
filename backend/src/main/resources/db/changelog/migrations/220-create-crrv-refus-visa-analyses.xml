<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="220-create-crrv-refus-visa-analyses" author="legalcase">
        <comment>
            SF-208-03 : table dédiée à l'outil décisionnel "CRRV recours refus de visa
            (2 mois)" — CESEDA L.312-1 à L.312-3 + D.312-3 + arrêté 10/03/2011.
            Calcule le délai de 2 mois pour saisir la Commission de recours contre les
            refus de visa (préalable obligatoire avant TA Nantes — R.312-3 CJA).
            Outil single-country FRANCE — pas d'équivalent BE (refus visa BE va
            directement au CCE).
            + 1 règle visibility F-IA-04 (ALWAYS_ON, DROIT_IMMIGRATION, FRANCE) — pas
            de flag IA dédié `refus_visa_detecte` aujourd'hui ; ALWAYS_ON pour
            permettre à l'avocat de saisir proactivement. À reconvertir CONTEXTUAL
            quand un flag IA dédié sera ajouté (F-205+ extension Immigration).

            Audit "Impact F-166 cross-C×D" : impacte uniquement Immigration FR.
            Audit "exhaustivité droit national FR" : équivalent BE = sans objet
            (CRRV est une institution française spécifique).
        </comment>

        <createTable tableName="crrv_refus_visa_analyses">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_crrv_refus_visa_analyses_case_file"
                             referencedTableName="case_files"
                             referencedColumnNames="id"/>
            </column>
            <column name="date_notification_refus" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="type_visa" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="motif_refus" type="varchar(255)">
                <constraints nullable="true"/>
            </column>
            <column name="recours_forme" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="date_recours" type="date">
                <constraints nullable="true"/>
            </column>
            <column name="country" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="result_data" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="crrv_refus_visa_analyses"
                             columnNames="case_file_id"
                             constraintName="uq_crrv_refus_visa_analyses_case_file"/>

        <createIndex tableName="crrv_refus_visa_analyses"
                     indexName="idx_crrv_refus_visa_analyses_case_file">
            <column name="case_file_id"/>
        </createIndex>

        <sql splitStatements="true">
INSERT INTO decision_tool_visibility_rules (id, legal_domain, country, tool_id, layer, trigger_field, trigger_value, priority)
VALUES ('f1a04001-0000-0000-0000-eeee20800230', 'DROIT_IMMIGRATION', 'FRANCE', 'F-IM-23-crrv-refus-visa-fr', 'ALWAYS_ON', NULL, NULL, 72);
        </sql>

        <rollback>
            <sql>
                DELETE FROM decision_tool_visibility_rules
                WHERE id = 'f1a04001-0000-0000-0000-eeee20800230';
            </sql>
            <dropTable tableName="crrv_refus_visa_analyses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
