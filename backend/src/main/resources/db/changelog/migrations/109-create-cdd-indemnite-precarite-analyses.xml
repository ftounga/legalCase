<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="109-create-cdd-indemnite-precarite-analyses" author="legalcase">
        <comment>
            SF-DT-17-01 : table dédiée à l'outil décisionnel "Indemnité de précarité CDD"
            (art. L.1243-8 Code du travail) + règle d'affichage F-IA-04 (ALWAYS_ON,
            DROIT_DU_TRAVAIL, FRANCE).
        </comment>

        <createTable tableName="cdd_indemnite_precarite_analyses">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_cdd_indemnite_precarite_analyses_case_file"
                             referencedTableName="case_files"
                             referencedColumnNames="id"/>
            </column>
            <column name="total_salaires_bruts" type="numeric(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="taux_precarite" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="cas_exclusion" type="varchar(50)">
                <constraints nullable="true"/>
            </column>
            <column name="result_data" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="cdd_indemnite_precarite_analyses"
                             columnNames="case_file_id"
                             constraintName="uq_cdd_indemnite_precarite_analyses_case_file"/>

        <createIndex tableName="cdd_indemnite_precarite_analyses"
                     indexName="idx_cdd_indemnite_precarite_analyses_case_file">
            <column name="case_file_id"/>
        </createIndex>

        <sql>
            INSERT INTO decision_tool_visibility_rules (id, legal_domain, country, tool_id, layer, trigger_field, trigger_value, priority)
            VALUES ('f1a04001-0000-0000-0000-ee0000000017', 'DROIT_DU_TRAVAIL', 'FRANCE', 'F-DT-17-cdd-indemnite-precarite', 'ALWAYS_ON', NULL, NULL, 50);
        </sql>

        <rollback>
            <sql>
                DELETE FROM decision_tool_visibility_rules
                WHERE id = 'f1a04001-0000-0000-0000-ee0000000017';
            </sql>
            <dropTable tableName="cdd_indemnite_precarite_analyses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
