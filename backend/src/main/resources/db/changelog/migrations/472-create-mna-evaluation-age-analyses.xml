<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="472-create-mna-evaluation-age-analyses" author="legalcase">
        <comment>
            SF-214-27 : table dédiée à l'outil décisionnel "MNA évaluation d'âge"
            (F-IM-38-mna-evaluation-age-fr, FRANCE uniquement). Guide la procédure
            d'évaluation d'âge d'un mineur non accompagné refusé par l'ASE, les
            recours devant le juge des enfants et la contestation des examens
            osseux. 1:1 case_file.
        </comment>

        <createTable tableName="mna_evaluation_age_analyses">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_mna_evaluation_age_analyses_case_file"
                             referencedTableName="case_files"
                             referencedColumnNames="id"/>
            </column>
            <column name="date_naissance_declaree" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="evaluation_ase_refusee" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="date_refus_ase" type="date">
                <constraints nullable="true"/>
            </column>
            <column name="examen_osseux_ordonne" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="statut" type="varchar(40)">
                <constraints nullable="false"/>
            </column>
            <column name="country" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="result_data" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="mna_evaluation_age_analyses"
                             columnNames="case_file_id"
                             constraintName="uq_mna_evaluation_age_analyses_case_file"/>

        <createIndex tableName="mna_evaluation_age_analyses"
                     indexName="idx_mna_evaluation_age_analyses_case_file">
            <column name="case_file_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="mna_evaluation_age_analyses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
