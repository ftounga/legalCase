<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="132-create-indemnite-fin-mission-interim-analyses" author="legalcase">
        <comment>
            SF-DT-18-01 : table dédiée à l'outil décisionnel "Indemnité de fin de mission
            intérim" (art. L.1251-32 Code du travail) + règle d'affichage F-IA-04
            (ALWAYS_ON, DROIT_DU_TRAVAIL, FRANCE, priority 51). Pattern miroir strict
            de F-DT-17 (CDD), situation métier distincte.
        </comment>

        <createTable tableName="indemnite_fin_mission_interim_analyses">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_indemnite_fin_mission_interim_analyses_case_file"
                             referencedTableName="case_files"
                             referencedColumnNames="id"/>
            </column>
            <column name="total_remunerations_brutes_eur" type="numeric(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="duree_mission_jours" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="motif_exclusion" type="varchar(60)">
                <constraints nullable="true"/>
            </column>
            <column name="date_fin_mission" type="date">
                <constraints nullable="true"/>
            </column>
            <column name="result_data" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="indemnite_fin_mission_interim_analyses"
                             columnNames="case_file_id"
                             constraintName="uq_indemnite_fin_mission_interim_analyses_case_file"/>

        <createIndex tableName="indemnite_fin_mission_interim_analyses"
                     indexName="idx_indemnite_fin_mission_interim_analyses_case_file">
            <column name="case_file_id"/>
        </createIndex>

        <sql>
            INSERT INTO decision_tool_visibility_rules (id, legal_domain, country, tool_id, layer, trigger_field, trigger_value, priority)
            VALUES ('f1a04001-0000-0000-0000-ee0000000181', 'DROIT_DU_TRAVAIL', 'FRANCE', 'F-DT-18-fin-mission-interim', 'ALWAYS_ON', NULL, NULL, 51);
        </sql>

        <rollback>
            <sql>
                DELETE FROM decision_tool_visibility_rules
                WHERE id = 'f1a04001-0000-0000-0000-ee0000000181';
            </sql>
            <dropTable tableName="indemnite_fin_mission_interim_analyses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
