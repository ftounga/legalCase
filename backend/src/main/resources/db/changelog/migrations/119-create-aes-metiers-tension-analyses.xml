<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="119-create-aes-metiers-tension-analyses" author="legalcase">
        <comment>
            SF-IM-09-01 : table dédiée à l'outil décisionnel "AES Métiers en tension"
            (art. 26 loi 2024-42 du 26/01/2024 + CESEDA L.435-4). Calcule l'éligibilité
            d'un étranger à l'admission exceptionnelle au séjour au titre d'un métier
            figurant sur la liste régionale des métiers en tension. Conditions :
            présence 3 ans + 12 mois d'activité salariée dans les 24 derniers mois +
            métier en tension + pas de menace ordre public + contrat ou promesse valide.
            Outil single-country FRANCE — pas d'équivalent BE standard pour ce régime
            expérimental 2024-2026.
            + 1 règle visibility F-IA-04 (ALWAYS_ON, DROIT_IMMIGRATION, FRANCE,
            priority 60) pour exposer l'outil sur tout dossier immigration FR.
        </comment>

        <createTable tableName="aes_metiers_tension_analyses">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_aes_metiers_tension_analyses_case_file"
                             referencedTableName="case_files"
                             referencedColumnNames="id"/>
            </column>
            <column name="date_entree_france" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="mois_activite_salariee_dernieres_24_mois" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="metier_est_en_tension" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="code_metier" type="varchar(20)">
                <constraints nullable="true"/>
            </column>
            <column name="menace_ordre_public" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="contrat_ou_promesse_valide" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="date_depot_demande" type="date">
                <constraints nullable="true"/>
            </column>
            <column name="country" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="result_data" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="aes_metiers_tension_analyses"
                             columnNames="case_file_id"
                             constraintName="uq_aes_metiers_tension_analyses_case_file"/>

        <createIndex tableName="aes_metiers_tension_analyses"
                     indexName="idx_aes_metiers_tension_analyses_case_file">
            <column name="case_file_id"/>
        </createIndex>

        <sql splitStatements="true">
            INSERT INTO decision_tool_visibility_rules (id, legal_domain, country, tool_id, layer, trigger_field, trigger_value, priority)
            VALUES ('f1a04001-0000-0000-0000-ee000000091a', 'DROIT_IMMIGRATION', 'FRANCE', 'F-IM-09-aes-metiers-tension', 'ALWAYS_ON', NULL, NULL, 60);
        </sql>

        <rollback>
            <sql>
                DELETE FROM decision_tool_visibility_rules
                WHERE id = 'f1a04001-0000-0000-0000-ee000000091a';
            </sql>
            <dropTable tableName="aes_metiers_tension_analyses"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
