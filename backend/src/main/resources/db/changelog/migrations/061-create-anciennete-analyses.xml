<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="061-create-anciennete-analyses" author="legalcase">
        <createTable tableName="anciennete_analyses">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_anciennete_analyses_case_file"
                             referencedTableName="case_files"
                             referencedColumnNames="id"/>
            </column>
            <column name="convention_code" type="varchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="date_entree" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="result_data" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="anciennete_analyses"
                             columnNames="case_file_id"
                             constraintName="uq_anciennete_analyses_case_file"/>

        <createIndex tableName="anciennete_analyses"
                     indexName="idx_anciennete_analyses_case_file">
            <column name="case_file_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
