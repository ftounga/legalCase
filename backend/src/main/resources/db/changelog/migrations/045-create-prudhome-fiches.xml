<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="045-create-prudhome-fiches" author="ailegalcase">
        <createTable tableName="prudhome_fiches">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="case_file_id" type="UUID">
                <constraints nullable="false"
                             unique="true"
                             uniqueConstraintName="uq_prudhome_fiches_case_file_id"
                             foreignKeyName="fk_prudhome_fiches_case_file"
                             references="case_files(id)"
                             deleteCascade="true"/>
            </column>
            <column name="demandeur" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="defendeur" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="demandes" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="faits_texte" type="TEXT"/>
            <column name="moyens_droit_texte" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="prudhome_fiches" indexName="idx_prudhome_fiches_case_file_id">
            <column name="case_file_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
