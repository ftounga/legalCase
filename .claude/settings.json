{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-dangerous-bash.sh\"",
            "timeout": 10,
            "statusMessage": "Garde-fou gouvernance (push/merge/backlog)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/self-check-grep.sh\"",
            "timeout": 15,
            "statusMessage": "Self-check décisionnel frontend"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/smoke-if-transversal.sh\"",
            "timeout": 10,
            "statusMessage": "Rappel E2E si transversal"
          }
        ]
      }
    ]
  }
}
